# 放入 /etc/nginx/conf.d/animetrack-rate-limits.conf。
# limit_req_zone 只能位于 Nginx 的 http 上下文，不能写入 server 块。

map $http_upgrade $animetrack_connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=animetrack_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=animetrack_ai:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=animetrack_data_write:10m rate=6r/m;
# MCP 查询和 OAuth 端点共用独立限流，避免公网连接影响应用其他入口。
limit_req_zone $binary_remote_addr zone=animetrack_mcp:10m rate=60r/m;
